NODE_ENV=MY_SERVER_ENV
PORT=MY_PORT

MONGO_URI=MY_MONGO_URI

JWT_ACCESS_SECRET=MY_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=MY_JWT_REFRESH_SECRET
JWT_ACCESS_TTL=MY_JWT_ACCESS_TTL
JWT_REFRESH_TTL=MY_JWT_REFRESH_TTL

BCRYPT_ROUNDS=MY_BCRYPT_ROUNDS

CORS_ORIGIN=MY_CORS_ORIGIN
LOG_LEVEL=MY_LOG_LEVEL

# Email (Gmail) for signup OTP — use a Gmail address + 16-char App Password
# (Google account → Security → 2-Step Verification → App passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-address@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM=Clean Pro <your-address@gmail.com>

# OTP settings
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Crash/error reporting (optional). Leave unset to disable Sentry.
# Create a Node project in Sentry and paste its DSN here.
SENTRY_DSN=
  